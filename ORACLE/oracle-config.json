{
  // ORACLE configuration
  // Paths and mappings for KTM Offroad Racing telemetry processing
  //
  // If this file is missing, the defaults from OracleConfig.cs are used.

  "DatabaseDirectory": "C:\\KTM Tools\\KTM Offroad Racing Shared Resources\\DistributedTools\\resources",
  "DatabaseFileName": "KOMPASS.json",

  // MotoDB loadChannels.xlsx: its CIRCUITS/HED sheets are synchronized from KOMPASS (ORACLE.exe sync-motodb).
  "MotoDbLoadChannelsPath": "C:\\KTM Tools\\KTM MotoDB\\loadChannels.xlsx",

  "TeamMappings": {
    "01_KTM-FR": "KTM Factory Racing",
    "KTM-FR": "KTM Factory Racing",
    "02_HQV": "Husqvarna Factory Racing",
    "HQV": "Husqvarna Factory Racing",
    "03_KTM-DC": "KTM De Carli Racing",
    "KTM-DC": "KTM De Carli Racing"
  },

  // Canonically renames device folders containing spaces ("AA 01" -> "AA01") so that the
  // bikeName is consistently space-free in folders and XML. Non-fatal + guarded.
  // Set to false if downstream tools (e.g. KRAKEN) expect the original folder names.
  "NormalizeDeviceFolderName": true,

  // Move orphaned, empty lap folders (leftovers of a WinTAX lap split, without cableData.ztx and not in RunLapHeader.xml)
  // to Run_x\\_ORACLE_removed so that WinTAX recognizes the run again. Nothing is deleted.
  "RepairOrphanLapFolders": true,

  // true = existing .HED values (rider, team, season ...) take precedence over KOMPASS (only warn on mismatch).
  // false (default) = KOMPASS master data replaces mismatching .HED values, e.g. a placeholder rider.
  "PreferHedMetadata": false,

  // Thresholds for race detection (RaceSegmentDetector).
  // Purely GPS-based (lat/lon distance + derived speed) + throttle position;
  // RPM and GPS quality only as guards. vRearnEng is deliberately NOT used.
  "RaceDetection": {
    "EngineOnMinRpm": 2000,
    "DistanceMinMeters": 1000,
    "TrackLengthFactor": 0.5,
    "SpeedMinKph": 25,
    "ThrottleMinPercent": 15,
    "ThrottleFallbackPercent": 20,
    "RpmRaceMin": 5000,
    "MinValidGpsSamples": 10
  },

  // GPS channels and preprocessing – applies to sVehicle, lap distances/track length, race detection and GPS lap split.
  // Like Lat_Valid/Lon_Valid in the VCH: remove samples without fix (0), bridge dropouts. Additionally:
  // merge repeated fixes, do not count GPS jumps (>= MinJumpMeters faster than MaxSpeedKph),
  // discard fragments < MinSegmentSeconds between two jumps as outliers.
  "Gps": {
    "LatitudeChannel": "Lat_dez",
    "LongitudeChannel": "Lon_dez",
    "MaxSpeedKph": 200,
    "MinJumpMeters": 10,
    "MinSegmentSeconds": 2
  },

  // GPS lap split (ORACLE split-laps <path> [--dry-run|--undo] or process <path> --gps-split).
  // Finish line = KOMPASS track coordinate, snapped onto the racing line, perpendicular to the riding direction (either direction).
  // Already split runs (WinTAX/ORACLE _Def_, logger laps) are detected and not split again.
  "GpsLapSplit": {
    "MinLapSeconds": 60,
    "MaxSampleGapSeconds": 1,
    "MinCrossingAngleDegrees": 30,
    "MinSpeedKph": 5,
    "SnapRadiusMeters": 50,
    "LineHalfWidthMeters": 12,
    "BoundaryToleranceSeconds": 2,
    "BoundaryDistanceMeters": 15,
    "FreeSpaceFactor": 1.2,
    "MaxTimeShiftSamples": 1
  },

  // Track length check before MotoDB (MotoDB compares trackLength EXACTLY with CIRCUITS; identical lengths = error).
  // Order: KOMPASS -> CIRCUITS -> .HED -> open suggestion -> estimate from the GPS lap distances.
  // Enforce = true: without an unambiguous length, exit code 6 (TrackLengthMissing) -> KRAKEN does not start MotoDB.
  // Provisional lengths are stored as a suggestion in SuggestionsDirectory and confirmed in KODE.
  "TrackLength": {
    "Enforce": true,
    "SuggestionsDirectory": "%OneDriveCommercial%\\Workstation - OffroadSync\\DevProjects\\KTM Internal Software Tools\\resources\\suggestions",
    "ExcludeFirstAndLastLap": true,
    "MinLapMeters": 300,
    "MaxLapMeters": 6000,
    "ClusterTolerance": 0.07,
    "MinLaps": 3,
    "MaxRelativeSpread": 0.03,
    "RoundToMeters": 1,
    "LockWaitSeconds": 120
  }
}
