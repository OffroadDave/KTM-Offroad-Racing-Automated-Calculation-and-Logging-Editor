    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>Ktm.Racing.RaceReport</RootNamespace>
    <AssemblyName>Ktm.Racing.ReportManager</AssemblyName>
    <Product>KTM Offroad Racing Report Manager</Product>
