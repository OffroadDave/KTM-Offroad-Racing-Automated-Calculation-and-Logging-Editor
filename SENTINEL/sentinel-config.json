{
    // Watched directories — SENTINEL searches them recursively for Run_* folders
    "watchPaths": [
        "C:\\MXTrackData"
    ],

    // Polling interval in seconds (recommended: 30s for OneDrive sync)
    "pollingIntervalSeconds": 30,

    // Number of consecutive stable checks before download.done is created
    // With a 30s interval and 3 checks: the run must remain unchanged for 90s
    "stabilityThreshold": 3,

    // Minimum file size in bytes (filters out OneDrive placeholders with 0 bytes)
    "minimumFileSizeBytes": 1024,

    // Ignore runs whose folder has been unchanged for more than N days (0 = disabled)
    "maxRunAgeDays": 0
}
