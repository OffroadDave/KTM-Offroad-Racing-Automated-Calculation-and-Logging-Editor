<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>Ktm.Racing.Core</RootNamespace>
    <AssemblyName>Ktm.Racing.Core</AssemblyName>
  </PropertyGroup>

  <!-- KTM telemetry DLLs are AMD64 native; consumers must build x64 to match. -->
  <ItemGroup>
    <PackageReference Include="Autofac" Version="6.3.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Ktm.Racing.Domain\src\Ktm.Racing.Domain\Ktm.Racing.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ktm.Racing.Tests" />
  </ItemGroup>

  <!-- Do NOT copy the KTM DLLs to output: they must load from the suite folder so their
       companion config/data/native files resolve next to them (see KtmRuntime). -->
  <ItemGroup>
    <Reference Include="KtmDataHandler">
      <HintPath>..\..\..\..\KTM Tools\KTM Utils Software Suite\KtmDataHandler.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="KtmSharedUtils">
      <HintPath>..\..\..\..\KTM Tools\KTM Utils Software Suite\KtmSharedUtils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Vbe.Interop">
      <HintPath>..\..\..\..\Program Files\Microsoft Office\root\vfs\ProgramFilesX86\Microsoft Office\Office16\DCF\Microsoft.Vbe.Interop.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
